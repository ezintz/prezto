#
# Executes commands at login pre-zshrc.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

#
# Browser
#

if [[ -z "$BROWSER" && "$OSTYPE" == darwin* ]]; then
  export BROWSER='open'
fi

#
# Android
#
## Wherever the android-commandlinetools cask put it (Apple silicon, then Intel).
for _android_home in /opt/homebrew/share/android-commandlinetools /usr/local/share/android-commandlinetools; do
  if [[ -d "$_android_home" ]]; then
    export ANDROID_HOME="$_android_home"
    break
  fi
done
unset _android_home

#
# Editors
#

if [[ -z "$EDITOR" ]]; then
  export EDITOR='vim'
fi
if [[ -z "$VISUAL" ]]; then
  export VISUAL='vim'
fi
if [[ -z "$PAGER" ]]; then
  export PAGER='less'
fi

#
# Language
#

## macOS is set to German region, but language should stay English. Only on
## macOS: a minimal Linux image may not have this locale generated at all.
if [[ "$OSTYPE" == darwin* ]]; then
  export LANG='en_US.UTF-8'
fi

#
# Paths
#

# Ensure path arrays do not contain duplicates.
typeset -gU cdpath fpath mailpath path

# Set the list of directories that cd searches.
# cdpath=(
#   $cdpath
# )

# Set the list of directories that Zsh searches for programs.
path=(
  /opt/{homebrew,local}/{,s}bin(N)
  /opt/homebrew/opt/openjdk/{,s}bin(N)
  /usr/local/{,s}bin(N)
  $path
  ${HOME}/{,s}bin(N)
  ${HOME}/.dotfiles/bin(N)
  ${HOME}/.docker/bin(N)
  ${KREW_ROOT:-$HOME/.krew}/bin
  ${HOME}/.local/bin(N)
  ${HOME}/.cargo/bin(N)
  ${HOME}/.bun/bin(N)
  ${HOME}/.dotnet/tools(N)
  ${HOME}/.antigravity/antigravity/{,s}bin(N)
)

## The PATH entry above only makes a global tool findable; DOTNET_ROOT is what
## lets it run. The apphost resolves its runtime from DOTNET_ROOT, then
## /etc/dotnet/install_location, then /usr/local/share/dotnet -- never from
## PATH -- and Homebrew installs outside all three, so `ilspycmd` dies with
## "You must install .NET" until this is set. Homebrew repoints the opt symlink
## on upgrade; the Cellar path behind it carries the version and would go
## stale. $HOMEBREW_PREFIX is not usable: the `brew shellenv` below leaves it
## unset when this file is sourced.
() {
  local root=(/opt/homebrew/opt/dotnet/libexec(N) /usr/local/opt/dotnet/libexec(N))
  (( $#root )) && export DOTNET_ROOT=$root[1]
}

#
# Less
#

# Set the default Less options.
# Mouse-wheel scrolling has been disabled by -X (disable screen clearing).
# Remove -X to enable it.
if [[ -z "$LESS" ]]; then
  export LESS='-g -i -M -R -S -w -X -z-4'
fi

# Set the Less input preprocessor.
# Try both `lesspipe` and `lesspipe.sh` as either might exist on a system.
if [[ -z "$LESSOPEN" ]] && (( $#commands[(i)lesspipe(|.sh)] )); then
  export LESSOPEN="| /usr/bin/env $commands[(i)lesspipe(|.sh)] %s 2>&-"
fi

## Disable TMUX if shell is loaded by any IntelliJ IDE.
[[ ! -z "$INTELLIJ_ENVIRONMENT_READER" ]] && TMUX_AUTOSTART_DISABLE=1

## Support for multiple kubeconfig files.
## Base config plus every *.conf/*.yaml/*.yml in ~/.kube (real files or
## symlinks-to-files; the (-.N) qualifier follows links and nullglobs).
## The extension allowlist naturally skips `config`, dirs, and stray files.
KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
if [[ -d "$HOME/.kube" ]]; then
  for file in $HOME/.kube/*.conf(-.N) $HOME/.kube/*.yaml(-.N) $HOME/.kube/*.yml(-.N); do
    KUBECONFIG="${KUBECONFIG}:${file}"
  done
fi
export KUBECONFIG="${KUBECONFIG}"

# OrbStack command-line tools and integration.
source ~/.orbstack/shell/init.zsh 2>/dev/null || :

# Homebrew: Apple silicon, Intel, or Linuxbrew — whichever exists.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  if [[ -x "$_brew" ]]; then
    eval "$("$_brew" shellenv)"
    break
  fi
done
unset _brew

# Direnv (optional; skipped if not installed)
if (( ${+commands[direnv]} )); then
  export DIRENV_LOG_FORMAT=""
  eval "$(direnv hook zsh)"
fi

# Machine-local environment from the private overlay (~/.config/dotfiles).
source "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/zprofile" 2>/dev/null || :
# Keys: the overlay keeps them in an untracked file so its backup never has them.
source "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/secrets.env" 2>/dev/null || :
