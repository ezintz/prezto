#
# Executes commands at the start of an interactive session.
#
# Authors:
#   Sorin Ionescu <sorin.ionescu@gmail.com>
#

# In cmux, hand the terminal to a per-tab tmux session that survives cmux
# restarts and reboots; returns without doing anything anywhere else.
source "${ZDOTDIR:-$HOME}/.dotfiles/tmux/cmux.zsh" 2>/dev/null

# Source Prezto.
if [[ -s "${ZDOTDIR:-$HOME}/.dotfiles/prezto/init.zsh" ]]; then
  source "${ZDOTDIR:-$HOME}/.dotfiles/prezto/init.zsh"
fi

# The shell an agent runs commands in (Claude Code sets CLAUDECODE, Codex
# Inside tmux a modified key arrives as a CSI u sequence (tmux/tmux.conf sets
# extended-keys to always, for Claude Code), which zsh has no binding for: it
# ran the prefix as some other key and typed the rest, so a held Shift+Backspace
# filled the line with "7;2u". Each is fed back as the legacy key it stands for,
# so it does whatever that key is bound to in the current keymap.
() {
  local -A csi_u=(
    '^[[127;2u' '^?'     # Shift+Backspace
    '^[[127;5u' '^[^?'   # Ctrl+Backspace: backward-kill-word, as Alt+Backspace
    '^[[127;6u' '^[^?'   # Ctrl+Shift+Backspace
    '^[[9;2u'   '^[[Z'   # Shift+Tab: reverse-menu-complete
    '^[[32;2u'  ' '      # Shift+Space
    '^[[13;2u'  '^M'     # Shift+Enter
    '^[[13;5u'  '^M'     # Ctrl+Enter
  )
  local keymap seq
  # menuselect (the open completion menu, where Shift+Tab steps back) exists
  # only once zsh/complist is loaded, which otherwise happens at first use.
  zmodload -i zsh/complist
  for keymap in emacs viins menuselect; do
    for seq in ${(k)csi_u}; do
      bindkey -M $keymap -s $seq $csi_u[$seq]
    done
  done
}

# CODEX_THREAD_ID) behaves like the bash those commands are written for; each
# difference failed there silently rather than with an error:
# - CLOBBER: the directory module turns it off, and a refused `> file` only
#   printed "file exists" while the command carried on with the old file, e.g.
#   running the previous version of a script it meant to rewrite. Set after
#   Prezto, which is where that module runs.
# - SH_WORD_SPLIT: zsh leaves an unquoted `$var` whole, so `for f in $files`
#   ran once over the whole list.
if [[ -n $CLAUDECODE || -n $CODEX_THREAD_ID ]]; then
  setopt CLOBBER SH_WORD_SPLIT
fi

alias k='kubectl'
## Keep the Mac awake while Claude Code runs; caffeinate is macOS-only.
if (( ${+commands[caffeinate]} )); then
  alias claude='caffeinate -dimsu claude'
fi

# After a reboot, tmux/claude-session.sh leaves each restored pane the Claude
# Code conversation it was running. It is resumed at the first prompt, when
# startup (and any ssh-add passphrase prompt in it) is over; typed into the pane
# during startup instead, the line was lost. Not in Claude Code's own shell,
# which inherits TMUX_PANE from the pane Claude runs in.
if [[ -n $TMUX_PANE && -z $CLAUDECODE ]]; then
  _claude_resume() {
    add-zsh-hook -d precmd _claude_resume
    local file=~/.local/share/tmux/resurrect/claude-resume/${${(s:,:)TMUX}[2]}-${TMUX_PANE#%}
    [[ -r $file ]] || return 0
    local id=$(<$file)
    command rm -f -- $file
    [[ -n $id ]] && claude --resume $id
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _claude_resume
fi

# mise, fully: switches tool versions as the directory changes (zprofile only
# puts its shims on PATH).
if (( ${+commands[mise]} )); then
  eval "$(mise activate zsh)"
fi

# direnv (optional; skipped if not installed). Here rather than in zprofile:
# its hook runs before each prompt, so it is interactive setup, and zprofile
# runs only for login shells. After mise, which installs direnv here.
if (( ${+commands[direnv]} )); then
  export DIRENV_LOG_FORMAT=""
  eval "$(direnv hook zsh)"
fi

# Source machine-local interactive config (aliases, paths) — not tracked in repo.
source "${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/zshrc" 2>/dev/null || :
